# ==============================================================================
# SeaDino Git Ignore Configuration (Production & Research Standard)
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# Virtual Environments
.venv/
env/
venv/
ENV/
.env

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Model Checkpoints & Large Weights
*.ckpt
*.pt
*.pth
*.bin
checkpoints/
stage1_*
stage1_*/
stage2_*
stage2_*/

# Training Logs & Experiment Tracking
*.log
logs/
*_logs/
wandb
wandb/

# Data Archives & Shards
*.tar
*.tar.gz
*.zip
*.parquet
*.h5
*.hdf5
ssl_pretrain_shards/
shards/

# Heavy Binary Caches & Diagnostic Arrays
*.npz
benthicnet_shard_hashes.npz
coralmask_test_min_dists.npz

# Generated Media & Visualizations (unless in docs/assets)
eval_output/
leakage_inspection/
*.png
*.jpg
*.jpeg
*.svg
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg

# Track Key Clean Splits and Published Master Tables
*.csv
!substrate_depth_2_spatial_split.csv
!german_bank_2010_spatial_split.csv
!paper_ablation_tables.csv
!master_coral_all_epochs_full_clean.csv
!master_substrate_germanbank_all_epochs_clean.csv
!stage2_spotcheck.csv
!data/splits/*.csv
!data/manifests/*.txt
!results/*.csv
!results/**/*.csv

# Exclude Large Spatial Split Datafiles (>20MB) from git history
biota_spatial_split.csv
substrate_depth_2_data_*.csv
data/splits/biota_spatial_split.csv
data/splits/substrate_depth_2_data_*.csv

